#!/usr/bin/env bash

# Gradle Wrapper POSIX runner for Alpha-Flip v3.2
set -e

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
CLASSPATH="$DIR/gradle/wrapper/gradle-wrapper.jar"

# 1. Use system/action gradle if available (e.g., set up by gradle/actions/setup-gradle)
if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
fi

# 2. Otherwise download wrapper jar if missing
if [ ! -f "$CLASSPATH" ] || [ ! -s "$CLASSPATH" ]; then
    mkdir -p "$DIR/gradle/wrapper"
    curl -sSL -o "$CLASSPATH" https://raw.githubusercontent.com/gradle/gradle/v8.2.1/gradle/wrapper/gradle-wrapper.jar || \
    curl -sSL -o "$CLASSPATH" https://repo.gradle.org/artifactory/libs-releases/org/gradle/gradle-wrapper/8.2.1/gradle-wrapper-8.2.1.jar || true
fi

# 3. Determine java executable
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

exec "$JAVACMD" -Xmx2048m -Dfile.encoding=UTF-8 -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
