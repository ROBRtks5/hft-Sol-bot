# ==============================================================================
# Alpha-Flip v3.2 - Environment Configuration Template
# DO NOT COMMIT REAL PRIVATE KEYS, SEED PHRASES, OR PRODUCTION SECRETS.
# ==============================================================================

# Core Operating Mode: observe | shadow | live | recovering | paused | kill
TRADING_MODE=observe

# Hot Path Yellowstone gRPC & Solana RPC
HELIUS_API_KEY=YOUR_HELIUS_API_KEY_HERE
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY_HERE
SOLANA_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY_HERE
YELLOWSTONE_GRPC_ENDPOINT=https://grpc.helius.xyz:443
YELLOWSTONE_X_TOKEN=YOUR_YELLOWSTONE_AUTH_TOKEN_HERE

# Hot Wallet Security (Filesystem keypair only - NEVER put raw base58/seed phrase here!)
HOT_WALLET_KEYPAIR_PATH=/etc/alpha-flip/secrets/hot-wallet.json
COLD_WALLET_SWEEP_ADDRESS=YOUR_COLD_VAULT_PUBLIC_KEY_HERE

# Jito MEV Block Engine
JITO_BLOCK_ENGINE_URL=https://amsterdam.mainnet.block-engine.jito.wtf
JITO_TIP_ACCOUNT=96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5
MAX_JITO_TIP_LAMPORTS=10000000

# Cold Path Advisory Infrastructure
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_URL=postgresql://alpha_user:alpha_local_dev_password@127.0.0.1:5432/alpha_flip_journal

# Cold Intelligence & Profiling APIs
GMGN_API_KEY=YOUR_GMGN_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Telemetry and Logging
RUST_LOG=info,alpha_flip_hot=debug
COLD_LOG_LEVEL=INFO
